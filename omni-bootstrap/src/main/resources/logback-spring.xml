<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="omni-gateway"/>

    <springProfile name="plain-log">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="!plain-log">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"application":"${APP_NAME}"}</customFields>
                <includeMdcKeyName>deviceId</includeMdcKeyName>
                <includeMdcKeyName>protocol</includeMdcKeyName>
                <includeMdcKeyName>channelId</includeMdcKeyName>
                <includeMdcKeyName>event</includeMdcKeyName>
            </encoder>
        </appender>
    </springProfile>

    <logger name="com.omni.gateway" level="INFO"/>
    <!-- 协议十六进制流量：消息体为纯文本行，便于对照抓包 -->
    <logger name="com.omni.gateway.protocol.traffic" level="INFO" additivity="true"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.apache.kafka" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
