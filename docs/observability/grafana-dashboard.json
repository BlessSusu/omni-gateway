{
  "title": "OmniGateway Overview",
  "panels": [
    {"title": "Active connections", "targets": [{"expr": "omni_connections_active"}]},
    {"title": "Uplink rate", "targets": [{"expr": "rate(omni_messages_uplink_total[1m])"}]},
    {"title": "Downlink skip not local", "targets": [{"expr": "rate(omni_downlink_skip_not_local_total[5m])"}]},
    {"title": "Sniff failures", "targets": [{"expr": "rate(omni_sniff_failures_total[5m])"}]},
    {"title": "Kafka publish latency", "targets": [{"expr": "histogram_quantile(0.99, rate(omni_kafka_publish_seconds_bucket[5m]))"}]}
  ],
  "schemaVersion": 38,
  "version": 1
}
